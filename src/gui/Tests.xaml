<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="780" Height="860"
        MinWidth="640" MinHeight="640"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12">
    <DockPanel Margin="12">
        <TextBlock x:Name="lblStatus" DockPanel.Dock="Top" Height="20"/>
        <ProgressBar x:Name="barProgress" DockPanel.Dock="Top"
                     Height="18" Margin="0,6,0,8" IsIndeterminate="True"/>
        <Button x:Name="btnStop" DockPanel.Dock="Bottom"
                Width="95" Height="28" HorizontalAlignment="Right"
                Margin="0,10,0,0"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>
            <GroupBox x:Name="grpTestHead" Grid.Row="0" Margin="0,0,0,8">
                <TextBox x:Name="txtHead" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11" BorderThickness="0"/>
            </GroupBox>
            <GroupBox x:Name="grpTestStrats" Grid.Row="1" Margin="0,0,0,8">
                <Grid>
                    <TabControl x:Name="tabStrategies" TabStripPlacement="Left"
                                Padding="4"/>
                    <TextBlock x:Name="lblStratWait" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="Gray"/>
                </Grid>
            </GroupBox>
            <GroupBox x:Name="grpTestSum" Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="hostSummary" Margin="0,4,0,0"/>
                        <TextBlock x:Name="lblBest" Margin="0,8,0,0" FontWeight="Bold"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
