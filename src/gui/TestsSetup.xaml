<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="456" Height="458"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12">
    <Canvas Width="440" Height="420">
        <TextBlock x:Name="lblType" Canvas.Left="12" Canvas.Top="12"/>
        <RadioButton x:Name="rbStd" Canvas.Left="12" Canvas.Top="32"
                     GroupName="testType" IsChecked="True"/>
        <RadioButton x:Name="rbDpi" Canvas.Left="220" Canvas.Top="32"
                     GroupName="testType"/>
        <TextBlock x:Name="lblPick" Canvas.Left="12" Canvas.Top="62"/>
        <ScrollViewer Canvas.Left="12" Canvas.Top="82" Width="416" Height="250"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="listChecks"/>
        </ScrollViewer>
        <Button x:Name="btnAll" Canvas.Left="12" Canvas.Top="344"
                Width="80" Height="28"/>
        <Button x:Name="btnNone" Canvas.Left="98" Canvas.Top="344"
                Width="80" Height="28"/>
        <Button x:Name="btnRun" Canvas.Left="248" Canvas.Top="378"
                Width="90" Height="28" IsDefault="True"/>
        <Button x:Name="btnCancel" Canvas.Left="344" Canvas.Top="378"
                Width="84" Height="28" IsCancel="True"/>
    </Canvas>
</Window>
