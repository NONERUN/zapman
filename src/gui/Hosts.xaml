<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="436" Height="228"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12">
    <Canvas Width="420" Height="190">
        <TextBlock x:Name="lblText" Canvas.Left="12" Canvas.Top="12"
                   Width="396" Height="72" TextWrapping="Wrap"/>
        <Button x:Name="btnCopy" Canvas.Left="12" Canvas.Top="92"
                Width="190" Height="28"/>
        <Button x:Name="btnOpen" Canvas.Left="218" Canvas.Top="92"
                Width="190" Height="28"/>
        <TextBlock x:Name="lblCopied" Canvas.Left="12" Canvas.Top="128"
                   Width="300" Height="20"/>
        <Button x:Name="btnClose" Canvas.Left="325" Canvas.Top="150"
                Width="83" Height="28" IsDefault="True" IsCancel="True"/>
    </Canvas>
</Window>
