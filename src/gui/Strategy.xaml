<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="436" Height="394"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12">
    <Canvas Width="420" Height="356">
        <TextBlock x:Name="lblEngine" Canvas.Left="12" Canvas.Top="16" Width="70" Height="20"/>
        <RadioButton x:Name="rbWinws" Canvas.Left="88" Canvas.Top="14"
                     Width="80" Height="24" GroupName="engine"/>
        <RadioButton x:Name="rbWinws2" Canvas.Left="174" Canvas.Top="14"
                     Width="90" Height="24" GroupName="engine"/>
        <ListBox x:Name="listStrategies" Canvas.Left="12" Canvas.Top="42"
                 Width="396" Height="180"/>
        <Button x:Name="btnInst" Canvas.Left="12" Canvas.Top="260" Width="196" Height="28"/>
        <Button x:Name="btnRun" Canvas.Left="212" Canvas.Top="260" Width="196" Height="28"/>
        <Button x:Name="btnTests" Canvas.Left="12" Canvas.Top="296" Width="196" Height="28"/>
        <Button x:Name="btnNoneWork" Canvas.Left="212" Canvas.Top="296" Width="196" Height="28"/>
    </Canvas>
</Window>
