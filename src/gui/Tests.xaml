<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="656" Height="498"
        MinWidth="496" MinHeight="358"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Consolas" FontSize="12">
    <DockPanel Margin="12">
        <TextBlock x:Name="lblStatus" DockPanel.Dock="Top" Height="20"/>
        <ProgressBar x:Name="barProgress" DockPanel.Dock="Top"
                     Height="18" Margin="0,6,0,8" IsIndeterminate="True"/>
        <Button x:Name="btnStop" DockPanel.Dock="Bottom"
                Width="95" Height="28" HorizontalAlignment="Right"
                Margin="0,10,0,0"/>
        <TextBox x:Name="txtLog" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"/>
    </DockPanel>
</Window>
