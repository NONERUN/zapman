{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NONERUN/zapman/strategies/schema/lists.json",
  "title": "zapman list bundles",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "patternProperties": {
    "^[a-z0-9]+(-[a-z0-9]+)*$": {
      "$ref": "#/$defs/bundle"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "bundle": {
      "type": "object",
      "properties": {
        "hostlist": {
          "description": "--hostlist= refs (lists:, user: or bin: path)",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "hostlistExclude": {
          "description": "--hostlist-exclude= refs",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "ipset": {
          "description": "--ipset= refs",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "ipsetExclude": {
          "description": "--ipset-exclude= refs",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  }
}
