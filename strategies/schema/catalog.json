{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NONERUN/zapman/strategies/schema/catalog.json",
  "title": "zapman catalog",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "description": "catalog id: stock for the catalog of zapman",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "description": "name in the UI",
      "type": "string"
    },
    "spec": {
      "description": "format version: 2",
      "type": "integer",
      "const": 2
    }
  },
  "required": [
    "id",
    "title",
    "spec"
  ],
  "additionalProperties": false
}
