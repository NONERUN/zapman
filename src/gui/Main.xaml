<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="416" Height="604"
        MinWidth="416" MinHeight="604"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="Segoe UI" FontSize="12"
        Background="#FFF0F0F0">
    <Canvas Width="400" Height="566">
        <TextBlock x:Name="title" Canvas.Left="16" Canvas.Top="10"
                   FontSize="18" FontWeight="Bold"/>
        <RadioButton x:Name="rbRu" Canvas.Left="292" Canvas.Top="14"
                     Width="48" Height="20" GroupName="lang"/>
        <RadioButton x:Name="rbEn" Canvas.Left="340" Canvas.Top="14"
                     Width="48" Height="20" GroupName="lang"/>
        <TextBlock x:Name="lblBanner" Canvas.Left="16" Canvas.Top="42"
                   Width="368" Height="40" Padding="6,4"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
        <GroupBox x:Name="grpStatus" Canvas.Left="16" Canvas.Top="88"
                  Width="368" Height="102" Cursor="Hand">
            <Canvas>
                <TextBlock x:Name="lblBypass" Canvas.Left="12" Canvas.Top="8"
                           Width="344" Height="18" Foreground="DimGray" Cursor="Hand"/>
                <TextBlock x:Name="lblService" Canvas.Left="12" Canvas.Top="28"
                           Width="344" Height="18" Foreground="DimGray" Cursor="Hand"/>
                <TextBlock x:Name="lblInstalled" Canvas.Left="12" Canvas.Top="48"
                           Width="344" Height="16" Foreground="DimGray" Cursor="Hand"/>
                <TextBlock x:Name="lblDivert" Canvas.Left="12" Canvas.Top="66"
                           Width="344" Height="16" Foreground="DimGray" Cursor="Hand"/>
            </Canvas>
        </GroupBox>
        <Button x:Name="btnStart" Canvas.Left="16" Canvas.Top="198" Width="178" Height="28"/>
        <Button x:Name="btnStop" Canvas.Left="206" Canvas.Top="198" Width="178" Height="28"/>
        <Button x:Name="btnRemove" Canvas.Left="16" Canvas.Top="230" Width="178" Height="28"/>
        <Button x:Name="btnStrategy" Canvas.Left="206" Canvas.Top="230" Width="178" Height="28"/>
        <GroupBox x:Name="grpSettings" Canvas.Left="16" Canvas.Top="266" Width="368" Height="140">
            <Canvas>
                <TextBlock x:Name="lblGame" Canvas.Left="12" Canvas.Top="10"/>
                <ComboBox x:Name="cmbGame" Canvas.Left="92" Canvas.Top="6"
                          Width="118" Height="24" IsEditable="False"/>
                <TextBlock x:Name="lblIpset" Canvas.Left="216" Canvas.Top="10"/>
                <ComboBox x:Name="cmbIpset" Canvas.Left="276" Canvas.Top="6"
                          Width="80" Height="24" IsEditable="False"/>
                <CheckBox x:Name="chkAuto" Canvas.Left="12" Canvas.Top="38"/>
                <CheckBox x:Name="chkTray" Canvas.Left="12" Canvas.Top="58"/>
                <Button x:Name="btnFakes" Canvas.Left="12" Canvas.Top="86" Width="344" Height="28"/>
            </Canvas>
        </GroupBox>
        <GroupBox x:Name="grpTools" Canvas.Left="16" Canvas.Top="414" Width="368" Height="92">
            <Canvas>
                <Button x:Name="btnIpsetUpd" Canvas.Left="12" Canvas.Top="8" Width="168" Height="28"/>
                <Button x:Name="btnHosts" Canvas.Left="188" Canvas.Top="8" Width="168" Height="28"/>
                <Button x:Name="btnUpdates" Canvas.Left="12" Canvas.Top="42" Width="168" Height="28"/>
                <Button x:Name="btnDiag" Canvas.Left="188" Canvas.Top="42" Width="168" Height="28"/>
            </Canvas>
        </GroupBox>
    </Canvas>
</Window>
