{
  "$schema": "./schema/strategy.json",
  "spec": 2,
  "rules": [
    {
      "target": { "l7": ["quic"], "lists": ["general"], "exclude": ["exclude-hosts", "exclude-ips"] },
      "action": "fake-quic-google-11"
    },
    {
      "target": { "udp": ["19294-19344", "50000-50100"], "l7": ["discord", "stun", "unknown"], "anyProtocol": true },
      "action": {
        "desync": ["fake"],
        "repeats": 4,
        "cutoff": 4,
        "fake": {
          "discord": ["bin:quic_initial_www_google_com.bin", "bin:ACTIVE_DISCORD_UDP.bin"],
          "stun": ["bin:ACTIVE_DISCORD_UDP.bin"],
          "unknownUdp": ["bin:quic_initial_www_google_com.bin", "bin:ACTIVE_DISCORD_UDP.bin"]
        }
      }
    },
    { "target": "discord-media", "action": "fake-multisplit-681-google" },
    { "target": "google", "action": "hostfakesplit" },
    { "target": "tls-general", "action": "fake-multisplit-480-stun2-sferum" },
    { "target": "quic-ipset", "action": "fake-quic-google-11" },
    {
      "target": {
        "tcp": ["80", "443", "8443"],
        "l7": ["tls", "http"],
        "lists": ["ipset-all"],
        "exclude": ["exclude-hosts", "exclude-ips"],
        "excludeDomains": ["fonts.googleapis.com"]
      },
      "action": "fake-multisplit-480-stun2-sferum"
    },
    {
      "target": "gf-tcp",
      "action": {
        "desync": ["fake", "multisplit"],
        "repeats": 8,
        "cutoff": 4,
        "splitPos": "1",
        "seqovl": 664,
        "seqovlPattern": "bin:tls_clienthello_www_sferum_ru.bin",
        "fooling": ["ts"],
        "fake": {
          "tls": ["bin:stun2.bin", "bin:tls_clienthello_www_sferum_ru.bin"],
          "http": ["bin:tls_clienthello_www_sferum_ru.bin"]
        }
      }
    },
    {
      "target": "gf-udp",
      "action": {
        "desync": ["fake"],
        "repeats": 5,
        "cutoff": 4,
        "fake": { "unknownUdp": ["bin:quic_initial_4pda_to.bin", "bin:ACTIVE_GAME_UDP.bin"] }
      }
    }
  ]
}
